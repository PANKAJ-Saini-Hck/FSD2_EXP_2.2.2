target/
*.class
*.jar
*.war
*.ear

# Maven wrapper (keep wrapper scripts and jar if present)
!.mvn/wrapper/maven-wrapper.jar

# IDEs
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS files
.DS_Store
Thumbs.db

